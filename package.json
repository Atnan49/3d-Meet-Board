{
  "name": "3d-meet-board",
  "version": "0.2.2",
  "license": "MIT",
  "author": "Atnan49",
  "type": "module",
  "description": "Self-hosted 3D meeting room and corkboard collaboration space for Discord Activities with automatic Cloudflare HTTPS tunneling.",
  "homepage": "https://github.com/Atnan49/3d-Meet-Board#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atnan49/3d-Meet-Board.git"
  },
  "bugs": {
    "url": "https://github.com/Atnan49/3d-Meet-Board/issues"
  },
  "keywords": [
    "discord",
    "discord-activity",
    "threejs",
    "3d",
    "collaboration",
    "corkboard",
    "websocket",
    "cli",
    "self-hosted"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "3d-meet-board": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "dist/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev:server": "node --watch server/index.mjs",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/store.test.mjs server/config.test.mjs server/tunnel.test.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.0.0",
    "@types/three": "^0.172.0",
    "three": "^0.172.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
