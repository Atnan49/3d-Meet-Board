{
  "name": "3d-meet-board",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "description": "Ruang kolaborasi 3D untuk server Discord dengan papan anggota dan papan tempel sticky note, foto, serta benang penghubung real-time.",
  "bin": {
    "3d-meet-board": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "dist/",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev:server": "node --watch server/index.mjs",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/store.test.mjs server/config.test.mjs"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "express": "^4.21.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.0.0",
    "@types/three": "^0.172.0",
    "three": "^0.172.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
